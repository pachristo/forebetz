APP_NAME="Winsure Odds Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the exact URL you open in the browser (scheme + host, no trailing slash).
# Wrong APP_URL causes 401 on Filament FileUpload / Livewire POST /livewire/upload-file.
# Production (Winsure Odds backoffice):
# APP_URL=https://backoffice.winsureodds.com
APP_URL=http://localhost

# WordPress — used by php artisan blogs:import-wordpress
WORDPRESS_SITE_URL=https://winsureodds.com/article

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# Bcrypt cost for new hashes (registration, Filament “Update password”). Legacy imports often use $2y$10$.
BCRYPT_ROUNDS=10

# Optional: read-only legacy DB for php artisan memberships:import-from-rara-old (defaults to DB_* if unset)
# RARA_OLD_DB_HOST=tipsking_docker-db
# RARA_OLD_DB_PORT=3306
# RARA_OLD_DB_DATABASE=rara_old
# RARA_OLD_DB_USERNAME=root
# RARA_OLD_DB_PASSWORD=
#
# Sync catalog from legacy: php artisan plans:sync-from-rara-old-subscriptions (uses rara_old.subscriptions where status=0)
# Text link ads (header/footer): php artisan ads:import-text-links-from-rara-old

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# On HTTPS production (required behind Cloudflare):
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# After changing .env: php artisan config:clear && php artisan config:cache

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
MAIN_URL=http://localhost:8030
FRONT_APP_URL=http://localhost:8030

# api-sports (RapidAPI) — required for php artisan fetch:fixtures
API_FOOTBALL_KEY=
# Optional default fixture id for: php artisan odds:record-sample (API-Football fixture / fixtures.match_id)
ODDS_SAMPLE_MATCH_ID=
